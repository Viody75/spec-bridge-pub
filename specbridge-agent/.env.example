# Local development configuration
# For deployment, these are set via Terraform / the deploy command.

# Gemini platform configuration (default)
GOOGLE_GENAI_USE_ENTERPRISE=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global

# SpecBridge API and Neon persistence. Never commit real values.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
SPECBRIDGE_API_KEY=replace-with-a-long-random-value
TEXT_EMBEDDING_MODEL=gemini-embedding-001
AUTO_CREATE_SCHEMA=false
DISABLE_API_KEY_AUTH=false
MAX_SOURCES_PER_RUN=50
MAX_NORMALIZED_CHARACTERS=100000
MAX_UPLOAD_BYTES=26214400
MAX_PDF_PAGES=200
MAX_DOCX_UNCOMPRESSED_BYTES=104857600
RETRIEVAL_TOP_K=5
WORKFLOW_TIMEOUT_SECONDS=600
MAX_UPLOAD_FILES=10
MAX_UPLOAD_BATCH_BYTES=31457280
# OCR for scanned PDF pages and images uses Gemini (defaults to the agent model)
OCR_ENABLED=true
MAX_OCR_PAGES=30
# Background analysis jobs (queue lives in the analysis_runs table)
ANALYSIS_WORKER_ENABLED=true
ANALYSIS_WORKER_CONCURRENCY=1
ANALYSIS_JOB_STALE_SECONDS=900
MODEL_MAX_OUTPUT_TOKENS=8192
OTEL_TO_CLOUD=false

# Alternatively, for Gemini API via Google AI Studio,
# comment out the three lines above and uncomment:
# GEMINI_API_KEY=your-api-key-here
